rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // NOTE: The app currently performs some reads via the client Firebase SDK
    // (athlete report/upload/about pages), so client access is left open for
    // now. The secure target is `allow read, write: if false;` once those reads
    // are migrated to the server-side Admin SDK routes.
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 7, 8);
    }
  }
}
